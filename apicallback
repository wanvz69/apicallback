live
The item a Vending Machine or DigiVend is selling, 0 when the machine is empty. nil when the tile is not a vending machine, so this doubles as the "is this a machine" test.

for _, t in ipairs(world:getTiles()) do
    local id = t:getVendingItem()
    if id and id ~= 0 then
        local price = t:getVendingPrice()
        local terms = price < 0 and (-price .. " per World Lock") or (price .. " World Locks each")
        player:onConsoleMessage(getItem(id):getName() .. ": " .. t:getVendingCount() .. " left at " .. terms)
